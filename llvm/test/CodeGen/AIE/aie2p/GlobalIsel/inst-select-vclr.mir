# RUN: llc -mtriple aie2p -run-pass=instruction-select %s -verify-machineinstrs -o - | FileCheck %s

# VCLR clears a 2048-bit DM register; a 1024-bit zero accumulator is its low
# half.
---
name:            test_broadcast_zero_to_v16acc64
legalized:       true
regBankSelected: true
body:             |
  bb.1.entry:
    ; CHECK-LABEL: name: test_broadcast_zero_to_v16acc64
    ; CHECK: [[VCLR:%[0-9]+]]:edm = VCLR
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:ecml = COPY [[VCLR]].sub_1024_acc_lo
    ; CHECK-NEXT: $cml0 = COPY [[COPY]]
    ; CHECK-NEXT: PseudoRET implicit $lr, implicit $cml0
    %0:accregbank(<16 x s64>) = G_INTRINSIC intrinsic(@llvm.aie2p.vbroadcast.zero.acc1024)
    $cml0 = COPY %0(<16 x s64>)
    PseudoRET implicit $lr, implicit $cml0
...
